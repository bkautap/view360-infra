# Statische configuratie. Beheerd door Ansible.
api:
  dashboard: true

log:
  level: INFO

accessLog:
  filePath: /var/log/traefik/access.log
  format: json

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"

# Docker lezen via socket-proxy (alleen lezen), niet via de socket zelf
providers:
  docker:
    endpoint: "tcp://socketproxy:2375"
    exposedByDefault: false
    network: {{ proxy_network }}
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  le:
    acme:
      email: "{{ acme_email }}"
      storage: /letsencrypt/acme.json
      httpChallenge:
        entryPoint: web

# Beheerd door Ansible. Niet handmatig aanpassen.
services:
  keycloak-db:
    image: postgres:{{ versions.postgres }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: keycloak
      POSTGRES_USER: keycloak
      POSTGRES_PASSWORD: "{{ vault_keycloak_db_password }}"
    volumes:
      - keycloak-db:/var/lib/postgresql/data
    networks: [keycloak-backend]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U keycloak -d keycloak"]
      interval: 10s
      retries: 10

  keycloak:
    image: quay.io/keycloak/keycloak:{{ versions.keycloak }}
    restart: unless-stopped
    command: ["start", "--import-realm"]
    depends_on:
      keycloak-db:
        condition: service_healthy
    environment:
      KC_DB: postgres
      KC_DB_URL: "jdbc:postgresql://keycloak-db:5432/keycloak"
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: "{{ vault_keycloak_db_password }}"
      KC_HOSTNAME: "{{ keycloak_host }}"
      KC_PROXY_HEADERS: xforwarded
      KC_HTTP_ENABLED: "true"
      KC_HEALTH_ENABLED: "true"
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: "{{ vault_keycloak_admin_password }}"
    volumes:
      - ./realm/leadership3-realm.json:/opt/keycloak/data/import/leadership3-realm.json:ro
    networks: [proxy, keycloak-backend]
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ proxy_network }}"
      - "traefik.http.routers.keycloak.rule=Host(`{{ keycloak_host }}`)"
      - "traefik.http.routers.keycloak.entrypoints=websecure"
      - "traefik.http.routers.keycloak.tls.certresolver=le"
      - "traefik.http.routers.keycloak.middlewares={{ route_middlewares }}"
      - "traefik.http.services.keycloak.loadbalancer.server.port=8080"

volumes:
  keycloak-db:
    name: keycloak-db

networks:
  proxy:
    external: true
  keycloak-backend:
    internal: true
